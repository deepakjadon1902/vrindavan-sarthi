{
  "name": "vrindavansarthi-backend",
  "version": "1.0.0",
  "description": "Vrindavan Sarthi Enterprises Backend API - Node.js, Express, MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/phase1-security.test.js tests/phase2-reservation.test.js tests/phase3-modification.test.js",
    "test:integration": "node --test tests/phase2-reservation.integration.test.js",
    "test:all": "node --test --test-concurrency=1 tests/*.test.js",
    "test:queue": "node --test tests/phase4-queue.foundation.js",
    "test:webhook": "node --test tests/phase4-2-webhook.foundation.js",
    "test:refund": "node --test tests/phase4-3-refund.foundation.js",
    "test:reconciliation": "node --test tests/phase4-4-payment-reconciliation.foundation.js",
    "test:notification": "node --test tests/phase4-5-notification.foundation.js",
    "test:operations": "node --test tests/phase4-6-operations.foundation.js",
    "test:rates": "node --test tests/phase5-rate-engine.test.js",
    "test:channel": "node --test tests/phase6-channel-manager.test.js",
    "test:ota": "node --test tests/phase7-ota-distribution.test.js",
    "test:hardening": "node --test tests/phase8-production-hardening.test.js",
    "worker": "node worker.js",
    "migrate:cloudinary": "node scripts/migrate-cloudinary.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "redis": "^6.2.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
