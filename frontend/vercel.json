{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.vrindavansarthi.in" }],
      "destination": "https://vrindavansarthi.in/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:file(robots.txt|sitemap.xml|sitemap-index.xml|sitemap-pages.xml|sitemap-products.xml|sitemap-tours.xml|sitemap-images.xml|manifest.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
