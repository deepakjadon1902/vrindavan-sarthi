{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/:file(robots.txt|sitemap.xml|sitemap-index.xml|sitemap-pages.xml|sitemap-products.xml|sitemap-tours.xml|sitemap-images.xml|manifest.webmanifest|favicon.ico|favicon.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" },
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/icons/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/sitemap-index.xml", "destination": "/sitemap-index.xml" },
    { "source": "/sitemap-pages.xml", "destination": "/sitemap-pages.xml" },
    { "source": "/sitemap-products.xml", "destination": "/sitemap-products.xml" },
    { "source": "/sitemap-tours.xml", "destination": "/sitemap-tours.xml" },
    { "source": "/sitemap-images.xml", "destination": "/sitemap-images.xml" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/icons/:path*", "destination": "/icons/:path*" },
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
